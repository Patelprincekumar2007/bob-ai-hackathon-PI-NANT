# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── IBM watsonx.ai ─────────────────────────────────────────────────────────
# All four variables are OPTIONAL — the app runs in Demo Mode without them.
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Model to use — defaults to ibm/granite-13b-instruct-v2 if not set
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Streamlit (Part 3 dashboard) ───────────────────────────────────────────
# Port the Streamlit server listens on (default: 8501)
STREAMLIT_SERVER_PORT=8501
# Set to "true" to suppress the browser opening automatically
STREAMLIT_SERVER_HEADLESS=false

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
